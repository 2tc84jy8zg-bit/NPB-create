const POS_ORDER={投手:1,捕手:2,内野手:3,外野手:4};
function makeRoster(team){return ROSTERS[team].trim().split('\n').map(line=>{const [number,name,position,contract]=line.split('|');return{id:team+'-'+number+'-'+name,number,name,position,contract,status:'pool',custom:false}})}
const state={};
for(const t of Object.keys(ROSTERS)){
 const key='npb-roster-v2-'+t;
 try{state[t]=JSON.parse(localStorage.getItem(key))||makeRoster(t)}
 catch(e){state[t]=makeRoster(t)}
}
let view='pool';
const $=id=>document.getElementById(id);
const team=()=> $('team').value;
function save(){localStorage.setItem('npb-roster-v2-'+team(),JSON.stringify(state[team()]))}
function render(){
 const t=team(),players=state[t],q=$('search').value.trim().toLowerCase();
 let shown=players.filter(p=>{
  const inView=view==='all'||p.status===view;
  const match=!q||[p.name,p.number,p.position,p.contract].join(' ').toLowerCase().includes(q);
  return inView&&match
 });
 const sort=$('sort').value;
 shown.sort((a,b)=>sort==='name'?a.name.localeCompare(b.name,'ja'):sort==='position'?(POS_ORDER[a.position]-POS_ORDER[b.position]||Number(a.number)-Number(b.number)):Number(a.number)-Number(b.number));
 $('summary').innerHTML=`<span class="pill">名簿 ${players.length}人</span><span class="pill">一軍 ${players.filter(p=>p.status==='first').length}人</span><span class="pill">二軍 ${players.filter(p=>p.status==='second').length}人</span><span class="pill">未編成 ${players.filter(p=>p.status==='pool').length}人</span>`;
 $('listTitle').textContent=({pool:'全選手・未編成',first:'一軍',second:'二軍',all:'選手名簿'})[view];
 $('list').innerHTML='';
 if(!shown.length){$('list').innerHTML='<div class="empty">該当する選手はいません</div>';return}
 for(const p of shown){
  const div=document.createElement('div');div.className='player';
  const number=document.createElement('div');number.className='num';number.textContent=p.number;
  const info=document.createElement('div');info.className='pinfo';
  info.innerHTML='<div class="pname"></div><div class="meta"></div>';
  info.querySelector('.pname').textContent=p.name;
  info.querySelector('.meta').textContent=`${p.position} ・ ${p.contract==='育成'?'育成選手':'支配下'} ・ ${{pool:'未編成',first:'一軍',second:'二軍'}[p.status]}`;
  const actions=document.createElement('div');actions.className='actions';
  if(p.status!=='first'){const b=document.createElement('button');b.className='primary';b.textContent='一軍へ';b.onclick=()=>move(p.id,'first');actions.appendChild(b)}
  if(p.status!=='second'){const b=document.createElement('button');b.className='secondary';b.textContent='二軍へ';b.onclick=()=>move(p.id,'second');actions.appendChild(b)}
  if(p.status!=='pool'){const b=document.createElement('button');b.className='secondary';b.textContent='未編成';b.onclick=()=>move(p.id,'pool');actions.appendChild(b)}
  const del=document.createElement('button');del.className='danger';del.textContent='削除';
  del.onclick=()=>{if(confirm(p.name+'を名簿から削除しますか？')){state[t]=state[t].filter(x=>x.id!==p.id);save();render()}};
  actions.appendChild(del);div.append(number,info,actions);$('list').appendChild(div)
 }
}
function move(id,status){const p=state[team()].find(p=>p.id===id);if(p){p.status=status;save();render()}}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>{
 view=b.dataset.view;
 document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));
 render()
}));
$('team').addEventListener('change',()=>{
 view='pool';
 document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.view===view));
 render()
});
$('search').addEventListener('input',render);
$('sort').addEventListener('change',render);
$('addBtn').onclick=()=>{
 const name=$('newName').value.trim(),number=$('newNo').value.trim();
 if(!name){alert('選手名を入力してください');return}
 const p={id:team()+'-custom-'+Date.now(),number:number||'—',name,position:$('newPos').value,contract:$('newContract').value,status:$('newStatus').value,custom:true};
 state[team()].push(p);save();$('newName').value='';$('newNo').value='';
 view=p.status;
 document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.view===view));
 render()
};
$('exportBtn').onclick=()=>{
 const players=state[team()];
 const txt=players.map(p=>`${p.status==='first'?'一軍':p.status==='second'?'二軍':'未編成'}\t${p.number}\t${p.name}\t${p.position}\t${p.contract}`).join('\n');
 const blob=new Blob(['\ufeff'+txt],{type:'text/plain;charset=utf-8'});
 const url=URL.createObjectURL(blob),a=document.createElement('a');
 a.href=url;a.download=(team()==='tigers'?'阪神':'西武')+'編成.txt';a.click();URL.revokeObjectURL(url)
};
$('resetBtn').onclick=()=>{
 if(confirm('この球団の編成を初期状態に戻します。追加・削除・配置変更も消えます。よろしいですか？')){
  state[team()]=makeRoster(team());save();render()
 }
};
